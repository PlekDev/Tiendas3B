# Copia este archivo a .env y ajústalo. Nunca subas .env al repo.

# Proveedor LLM: none (solo heurísticas, corre en cualquier laptop) | ollama | openai
# Los documentos de 3B no deben salir del equipo: usa ollama (local) salvo que el
# comité autorice una API externa.
LLM_PROVIDER=none
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
LLM_NUM_CTX=8192
OLLAMA_BASE_URL=http://localhost:11434

# Solo si LLM_PROVIDER=openai y el comité lo autoriza (pip install -e ".[openai]")
# OPENAI_API_KEY=

# Rutas locales
DATA_DIR=data/raw
RULES_DIR=data/rules

# OCR para escaneos (pip install -e ".[ocr]" y el paquete tesseract-ocr-spa del sistema)
OCR_LANG=spa

# Un dato con confianza menor a esto cuenta como "en duda" → Requiere revisión
MIN_FIELD_CONFIDENCE=0.6

# Logs: consola + logs/tiendas3b.jsonl; bitácora de dictámenes en logs/bitacora.jsonl
LOG_LEVEL=INFO
LOG_DIR=logs

# Cola de trabajos y seguridad de la API (tareas A4 y A6)
MAX_WORKERS=2
JOB_TTL_S=3600
# Si API_KEY tiene valor, la API exige el header X-API-Key (401 si falta)
API_KEY=
CORS_ORIGINS=*
